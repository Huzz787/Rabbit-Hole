{
  "name": "the-rabbit-hole",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "node --env-file-if-exists=.env.local --env-file-if-exists=.env node_modules/prisma/build/index.js db push",
    "db:verify": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --experimental-strip-types scripts/verify-aiven.ts",
    "gemini:verify": "npx tsx --env-file=.env.local scripts/verify-gemini-integration.ts",
    "qa:test": "npx tsx --env-file=.env.local scripts/run-e2e-qa.ts"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.78.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-force-graph-2d": "^1.29.2",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "^6.19.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
