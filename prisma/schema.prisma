// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// The Rabbit Hole Database Schema (Aiven PostgreSQL)
// ==========================================

// Topics discovered or explored in the rabbit hole
model Topic {
  id          String   @id @default(cuid())
  title       String   @unique
  name        String?  // Legacy/alias field for backwards compatibility
  description String?  @db.Text
  summary     String?  @db.Text
  category    String?
  depth       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Connections where this topic is the source
  outgoingConnections TopicConnection[] @relation("SourceTopic")
  // Connections where this topic is the target
  incomingConnections TopicConnection[] @relation("TargetTopic")

  // Related discoveries and history
  savedDiscoveries   SavedDiscoveries[]
  explorationHistory ExplorationHistory[]

  @@index([title])
  @@index([category])
}

// Connections / relationships between topics in the knowledge graph
model TopicConnection {
  id            String   @id @default(cuid())
  sourceTopicId String
  targetTopicId String
  relationship  String?  // Description of how the two concepts interlink
  weight        Float    @default(1.0) // Connection strength
  createdAt     DateTime @default(now())

  sourceTopic Topic @relation("SourceTopic", fields: [sourceTopicId], references: [id], onDelete: Cascade)
  targetTopic Topic @relation("TargetTopic", fields: [targetTopicId], references: [id], onDelete: Cascade)

  @@unique([sourceTopicId, targetTopicId])
  @@index([sourceTopicId])
  @@index([targetTopicId])
}

// Exploration history tracking user journeys down the rabbit hole
model ExplorationHistory {
  id         String   @id @default(cuid())
  sessionId  String
  topicId    String
  exploredAt DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([topicId])
  @@index([exploredAt])
}

// User-saved or bookmarked discoveries
model SavedDiscoveries {
  id        String   @id @default(cuid())
  sessionId String
  topicId   String
  notes     String?  @db.Text
  savedAt   DateTime @default(now())

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([sessionId, topicId])
  @@index([sessionId])
  @@index([topicId])
  @@index([savedAt])
}

// ==========================================
// Preserved Existing Database Models
// (Preserved without modification to prevent data loss)
// ==========================================

model achievements {
  id                Int                 @id @default(autoincrement())
  name              String              @db.VarChar(100)
  slug              String              @unique @db.VarChar(50)
  description       String
  icon              String?             @default("fa-award") @db.VarChar(50)
  color             String?             @default("#4F46E5") @db.VarChar(20)
  points_reward     Int?                @default(0)
  created_at        DateTime?           @default(now()) @db.Timestamptz(6)
  user_achievements user_achievements[]
}

model answers {
  id           Int        @id @default(autoincrement())
  question_id  Int?
  user_id      Int?
  content      String
  code_snippet String?
  is_accepted  Boolean?   @default(false)
  upvotes      Int?       @default(0)
  downvotes    Int?       @default(0)
  created_at   DateTime?  @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?  @default(now()) @db.Timestamptz(6)
  questions    questions? @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  comments     comments[]
  votes        votes[]

  @@index([question_id], map: "idx_answers_question")
}

model bookmarks {
  id          Int        @id @default(autoincrement())
  user_id     Int?
  question_id Int?
  created_at  DateTime?  @default(now()) @db.Timestamptz(6)
  questions   questions? @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users?     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, question_id], map: "unique_user_bookmark")
  @@index([user_id], map: "idx_bookmarks_user")
}

model books {
  book_id      Int            @id @default(autoincrement())
  book_name    String         @db.VarChar(255)
  author       String         @db.VarChar(255)
  transactions transactions[]
}

model bounties {
  id                               Int        @id @default(autoincrement())
  question_id                      Int?
  offered_by                       Int?
  points_amount                    Int
  status                           String?    @default("open") @db.VarChar(20)
  claimed_by                       Int?
  created_at                       DateTime?  @default(now()) @db.Timestamptz(6)
  users_bounties_claimed_byTousers users?     @relation("bounties_claimed_byTousers", fields: [claimed_by], references: [id], onUpdate: NoAction)
  users_bounties_offered_byTousers users?     @relation("bounties_offered_byTousers", fields: [offered_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  questions                        questions? @relation(fields: [question_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model comments {
  id         Int       @id @default(autoincrement())
  answer_id  Int?
  user_id    Int?
  content    String
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  answers    answers?  @relation(fields: [answer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([answer_id], map: "idx_comments_answer")
}

model group_members {
  id           Int           @id @default(autoincrement())
  group_id     Int?
  user_id      Int?
  role         String?       @default("member") @db.VarChar(20)
  joined_at    DateTime?     @default(now()) @db.Timestamptz(6)
  study_groups study_groups? @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users        users?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([group_id, user_id], map: "unique_group_user")
}

model notifications {
  id                                   Int       @id @default(autoincrement())
  user_id                              Int?
  sender_id                            Int?
  type                                 String    @db.VarChar(50)
  title                                String?   @db.VarChar(150)
  message                              String
  link                                 String?   @db.VarChar(255)
  is_read                              Boolean?  @default(false)
  created_at                           DateTime? @default(now()) @db.Timestamptz(6)
  users_notifications_sender_idTousers users?    @relation("notifications_sender_idTousers", fields: [sender_id], references: [id], onUpdate: NoAction)
  users_notifications_user_idTousers   users?    @relation("notifications_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_notifications_user")
}

model questions {
  id                 Int         @id @default(autoincrement())
  title              String      @db.VarChar(255)
  description        String
  subject_id         Int?
  user_id            Int?
  tags               String?     @default("") @db.VarChar(255)
  image_url          String?     @db.VarChar(255)
  code_snippet       String?
  code_language      String?     @default("python") @db.VarChar(50)
  is_anonymous       Boolean?    @default(false)
  views              Int?        @default(0)
  is_solved          Boolean?    @default(false)
  accepted_answer_id Int?
  created_at         DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at         DateTime?   @default(now()) @db.Timestamptz(6)
  answers            answers[]
  bookmarks          bookmarks[]
  bounties           bounties[]
  subjects           subjects?   @relation(fields: [subject_id], references: [id], onUpdate: NoAction)
  users              users?      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([subject_id], map: "idx_questions_subject")
  @@index([user_id], map: "idx_questions_user")
}

model quiz_results {
  id              Int       @id @default(autoincrement())
  user_id         Int?
  subject_id      Int?
  score           Int
  total_questions Int?      @default(10)
  difficulty      String?   @default("medium") @db.VarChar(20)
  completed_at    DateTime? @default(now()) @db.Timestamptz(6)
  subjects        subjects? @relation(fields: [subject_id], references: [id], onUpdate: NoAction)
  users           users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model reports {
  id                                    Int       @id @default(autoincrement())
  reporter_id                           Int?
  reported_user_id                      Int?
  content_type                          String    @db.VarChar(50)
  content_id                            Int
  reason                                String
  status                                String?   @default("pending") @db.VarChar(20)
  created_at                            DateTime? @default(now()) @db.Timestamptz(6)
  users_reports_reported_user_idTousers users?    @relation("reports_reported_user_idTousers", fields: [reported_user_id], references: [id], onUpdate: NoAction)
  users_reports_reporter_idTousers      users?    @relation("reports_reporter_idTousers", fields: [reporter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model students {
  student_id   BigInt         @id @default(autoincrement())
  usn          String         @unique @db.VarChar(20)
  name         String         @db.VarChar(150)
  course       String?        @db.VarChar(100)
  age          Int?
  phone_no     String?        @db.VarChar(20)
  email        String?        @unique @db.VarChar(255)
  semester     Int?
  dept         String?        @db.VarChar(50)
  transactions transactions[]
}

model study_groups {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(150)
  description   String?
  subject_id    Int?
  created_by    Int?
  member_count  Int?            @default(1)
  is_private    Boolean?        @default(false)
  created_at    DateTime?       @default(now()) @db.Timestamptz(6)
  group_members group_members[]
  users         users?          @relation(fields: [created_by], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subjects      subjects?       @relation(fields: [subject_id], references: [id], onUpdate: NoAction)
}

model subjects {
  id           Int            @id @default(autoincrement())
  name         String         @unique @db.VarChar(100)
  slug         String         @unique @db.VarChar(100)
  description  String?        @default("")
  icon         String?        @default("fa-book") @db.VarChar(50)
  color        String?        @default("#4F46E5") @db.VarChar(20)
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  questions    questions[]
  quiz_results quiz_results[]
  study_groups study_groups[]
}

model transactions {
  transaction_id Int       @id @default(autoincrement())
  usn            String    @db.VarChar(50)
  book_id        Int
  borrow_date    DateTime? @default(now()) @db.Timestamptz(6)
  return_status  String    @default("BORROWED") @db.VarChar(20)
  returned_at    DateTime? @db.Timestamptz(6)
  borrow_time    DateTime? @db.Timestamp(6)
  books          books     @relation(fields: [book_id], references: [book_id], onDelete: Cascade)
  students       students  @relation(fields: [usn], references: [usn], onDelete: Cascade)

  @@index([book_id], map: "idx_transactions_book_id")
  @@index([return_status], map: "idx_transactions_status")
  @@index([usn], map: "idx_transactions_usn")
}

model user_achievements {
  id             Int           @id @default(autoincrement())
  user_id        Int?
  achievement_id Int?
  earned_at      DateTime?     @default(now()) @db.Timestamptz(6)
  achievements   achievements? @relation(fields: [achievement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users          users?        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, achievement_id], map: "unique_user_achievement")
}

model user_points {
  id           Int       @id @default(autoincrement())
  user_id      Int?
  points       Int
  action       String    @db.VarChar(100)
  description  String?   @db.VarChar(255)
  reference_id Int?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  users        users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_user_points_user")
}

model users {
  id                                           Int                 @id @default(autoincrement())
  full_name                                    String              @db.VarChar(150)
  username                                     String              @unique @db.VarChar(50)
  email                                        String              @unique @db.VarChar(150)
  password_hash                                String              @db.VarChar(255)
  college_name                                 String?             @db.VarChar(255)
  course                                       String?             @db.VarChar(100)
  year_of_study                                String?             @db.VarChar(50)
  profile_picture                              String?             @default("default_avatar.svg") @db.VarChar(255)
  bio                                          String?             @default("")
  skills                                       String?             @default("")
  interests                                    String?             @default("")
  reputation_points                            Int?                @default(0)
  role                                         String?             @default("student") @db.VarChar(20)
  is_active                                    Boolean?            @default(true)
  created_at                                   DateTime?           @default(now()) @db.Timestamptz(6)
  answers                                      answers[]
  bookmarks                                    bookmarks[]
  bounties_bounties_claimed_byTousers          bounties[]          @relation("bounties_claimed_byTousers")
  bounties_bounties_offered_byTousers          bounties[]          @relation("bounties_offered_byTousers")
  comments                                     comments[]
  group_members                                group_members[]
  notifications_notifications_sender_idTousers notifications[]     @relation("notifications_sender_idTousers")
  notifications_notifications_user_idTousers   notifications[]     @relation("notifications_user_idTousers")
  questions                                    questions[]
  quiz_results                                 quiz_results[]
  reports_reports_reported_user_idTousers      reports[]           @relation("reports_reported_user_idTousers")
  reports_reports_reporter_idTousers           reports[]           @relation("reports_reporter_idTousers")
  study_groups                                 study_groups[]
  user_achievements                            user_achievements[]
  user_points                                  user_points[]
  votes                                        votes[]
}

model votes {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  answer_id  Int?
  vote_type  Int
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  answers    answers?  @relation(fields: [answer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, answer_id], map: "unique_user_answer_vote")
  @@index([answer_id], map: "idx_votes_answer")
}
